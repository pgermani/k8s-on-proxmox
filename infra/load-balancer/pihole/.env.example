# Network configuration - replace the <...> placeholders with values from your
# home network (e.g. 192.168.1.0/24, router 192.168.1.1, a free address for Pi-hole)
NETWORK_INTERFACE=eth0
NETWORK_SUBNET=<HOME-NETWORK-CIDR>
NETWORK_GATEWAY=<ROUTER-IP>
PIHOLE_IP=<PIHOLE-IP>

# Pi-hole settings
TZ=Europe/Rome
PIHOLE_WEBPASSWORD=my-secret-passw